# HTTP Server
PORT=8080

# Database (SQLite - default, simple)
DB_PATH=./data/proxy.db

# For MariaDB instead (see docker-compose.mariadb.yml):
# DB_TYPE=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_USER=proxy_user
# DB_PASSWORD=your_secure_password_here
# DB_NAME=proxy_db

# AWS S3 / Cloudflare R2
# For R2: AWS_REGION=auto, S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# For AWS S3: AWS_REGION=eu-central-1, leave S3_ENDPOINT empty
AWS_REGION=auto
AWS_ACCESS_KEY_ID=your_r2_access_key_here
AWS_SECRET_ACCESS_KEY=your_r2_secret_key_here
S3_BUCKET=dl-proxy
S3_PREFIX=proxy
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Presigned URL expiry (duration format: 1h, 30m, etc.)
PRESIGNED_URL_EXPIRY=1h

# Smart Caching
# Only cache files that get X requests within the time window
# Example: 10 requests in 1 hour triggers caching
CACHE_THRESHOLD=10
CACHE_WINDOW=1h
# Delete cached files not requested for X days
CACHE_RETENTION_DAYS=30

# Logging
LOG_LEVEL=info
